#!/bin/sh
# FreeLinX passwd - set a user's password.
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 FreeLinX OS Project.
#
#   passwd          your own password
#   passwd USER     USER's password (root)
#
# The hash is made by flxpasswd, with the C library's crypt(3) - the code that
# checks it at login.  flxpasswd writes /etc/shadow, which only root can, and
# there is no setuid passwd here, so anyone else goes through doas: it asks for
# their own password first, which is the check a passwd program makes anyway.
# The password reaches flxpasswd on stdin, never on a command line.
set -u

user=${1:-$(id -un)}
case $user in
-h|--help) sed -n '4,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
-*) echo "passwd: unknown option $user" >&2; exit 2 ;;
esac

if [ "$(id -u)" -ne 0 ]; then
	if [ "$user" != "$(id -un)" ]; then
		echo "passwd: only root can set another user's password" >&2
		exit 1
	fi
	command -v doas >/dev/null 2>&1 ||
		{ echo 'passwd: needs doas to write /etc/shadow, and there is none' >&2; exit 1; }
	exec doas "$0" "$user"
fi

grep -q "^$user:" /etc/passwd || { echo "passwd: no such user: $user" >&2; exit 1; }

secret() {
	printf '%s: ' "$1" >/dev/tty
	stty -echo </dev/tty 2>/dev/null
	IFS= read -r _s </dev/tty || _s=
	stty echo </dev/tty 2>/dev/null
	printf '\n' >/dev/tty
	printf '%s' "$_s"
}
trap 'stty echo </dev/tty 2>/dev/null' EXIT INT TERM

echo "Changing the password for $user."
pw=$(secret 'New password')
[ -n "$pw" ] || { echo 'passwd: an empty password is not set; nothing changed' >&2; exit 1; }
again=$(secret 'New password again')
[ "$pw" = "$again" ] || { echo 'passwd: the two passwords did not match; nothing changed' >&2; exit 1; }

# A user with no /etc/shadow line yet gets a locked one, so a failure below
# leaves the account locked rather than open.
grep -q "^$user:" /etc/shadow 2>/dev/null ||
	printf '%s:!::0:99999:7:::\n' "$user" >>/etc/shadow
printf '%s:%s\n' "$user" "$pw" | flxpasswd -e -m 1 >/dev/null ||
	{ echo "passwd: flxpasswd could not set the password for $user" >&2; exit 1; }
pw='' again=''
echo "passwd: password for $user changed"
