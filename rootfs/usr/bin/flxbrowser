#!/bin/sh
# FreeLinX Browser Launcher (non-GNU)
# Launches Dillo in graphical mode if X11 is running, or Links in console mode.

# No local welcome page ships with the release rootfs (removed by design);
# default to a lightweight search page when no URL is given.
HOMEPAGE="https://duckduckgo.com/lite/"
URL="${1:-$HOMEPAGE}"

[ -s /etc/resolv.conf ] || printf "nameserver 10.0.2.3\nnameserver 1.1.1.1\nnameserver 8.8.8.8\n" > /etc/resolv.conf

if [ -n "${DISPLAY:-}" ]; then
    if [ -x /usr/bin/dillo ]; then
        exec /usr/bin/dillo "$URL"
    elif [ -x /usr/bin/links ]; then
        exec /usr/bin/links -g -ssl.certificates 0 "$URL"
    fi
fi

if [ -x /usr/bin/links ]; then
    exec /usr/bin/links -ssl.certificates 0 "$URL"
elif [ -x /usr/bin/lynx ]; then
    exec /usr/bin/lynx "$URL"
elif [ -x /usr/bin/w3m ]; then
    exec /usr/bin/w3m "$URL"
fi
