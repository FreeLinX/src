#!/bin/sh
# FreeLinX Browser Launcher (non-GNU)
# Launches Links in graphical mode (-g) if X11 is running, or text mode in console.

HOMEPAGE="/usr/share/freelinx/welcome.html"
URL="${1:-$HOMEPAGE}"

[ -s /etc/resolv.conf ] || printf "nameserver 10.0.2.3\nnameserver 1.1.1.1\nnameserver 8.8.8.8\n" > /etc/resolv.conf

if [ -n "${DISPLAY:-}" ]; then
    exec /usr/bin/links -g -ssl.certificates 0 "$URL"
else
    exec /usr/bin/links -ssl.certificates 0 "$URL"
fi
