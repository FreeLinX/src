# /etc/fstab: FreeLinX static filesystem table
# Boot model: Initramfs-Primary (the whole OS lives in the initramfs).
# The ext4 partition labeled FLX_HOME is the persistent /home storage;
# it is mounted at boot by /sbin/flxautomount (label-based) and by mount -a.
#
# <file system>      <mount point>  <type>  <options>                    <dump>  <pass>
LABEL=FLX_HOME       /home          ext4    defaults,noatime              0       2
proc                 /proc          proc    defaults                      0       0
sysfs                /sys           sysfs   defaults                      0       0
devpts               /dev/pts       devpts  gid=5,mode=0620,ptmxmode=0666 0       0
tmpfs                /run           tmpfs   defaults,nosuid,nodev,mode=0755 0     0
tmpfs                /tmp           tmpfs   defaults,nosuid,nodev          0       0