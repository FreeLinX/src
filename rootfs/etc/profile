# FreeLinX System Profile
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin
# The image's interactive shell, when it names one (base: mksh).  /bin/sh is
# the NetBSD shell, built here without libedit, so a person who lands in it
# gets arrow keys printing ^[ [A and no history.
SHELL=/bin/sh
[ -r /etc/flx-shell ] && [ -x "$(cat /etc/flx-shell)" ] && SHELL=$(cat /etc/flx-shell)
export SHELL
export SVDIR=/var/service

# TERM follows the terminal, not the other way round.
#
# This file used to set TERM=xterm-256color outright, on every console.  That is
# right on a virtual terminal and wrong on the serial line: the terminfo entry
# for xterm-256color describes a 256-column screen, and a serial console at
# 80x24 either finds no entry that fits or gets the wrong cursor addressing, so
# every curses program that opens the screen - vim, nnn, htop, less - renders
# wrong on a system that is otherwise fine.  The only thing that knows the answer
# is the terminal this shell was started on, and tty(1) resolves to it.
#
# An inherited TERM is left alone, so ssh, su and the xorg service keep the one
# their caller chose.
case $(tty 2>/dev/null) in
/dev/tty[0-9]*) _FLX_TERM=xterm-256color ;;
*) _FLX_TERM=linux ;;
esac
export TERM=${TERM:-$_FLX_TERM}
unset _FLX_TERM

HOSTNAME=$(cat /etc/hostname 2>/dev/null || echo freelinx)
export HOSTNAME

_UID=$(id -u 2>/dev/null || echo 0)
if [ "$_UID" -eq 0 ]; then
    export USER=root
    export LOGNAME=root
    export HOME=/root
    export PS1="root@$HOSTNAME:~# "
else
    _UNAME=$(id -un 2>/dev/null || whoami 2>/dev/null || echo user)
    export USER="$_UNAME"
    export LOGNAME="$_UNAME"
    export HOME="/home/$_UNAME"
    export PS1="$_UNAME@$HOSTNAME:~$ "
fi
unset _UID _UNAME

export ENV=/etc/profile

# The keyboard xsetup chose, and the time zone it was told, are read by the
# services that need them; the shell keeps them so a program started from here
# agrees with the rest of the system.
[ -r /etc/flx-kbd ] && export FLX_KBD="$(cat /etc/flx-kbd)"
[ -r /etc/TZ ] && export TZ="$(cat /etc/TZ)"

# English, and UTF-8: the image carries no locale archive of its own and the C
# library is built for the C.UTF-8 default, which is what the console renders.
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Line editing for interactive shells: arrow keys, history, Ctrl-R.  mksh has it
# built in (libedit) but starts with it off, so arrows print ^[ [A.
case $- in
    *i*) set -o emacs 2>/dev/null || : ;;
esac
