// FreeLinX: fastfetch prints a plain wordmark and uncolored text only.
// No logo colors, no key colors, no percentage colors, no palette bar.
// A user's own ~/.config/fastfetch/config.jsonc takes precedence over this file.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/fastfetch/logos/freelinx.txt",
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "pipe": true,
    "percent": { "type": 1 }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "locale"
  ]
}
