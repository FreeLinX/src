// FreeLinX: fastfetch shows the FreeLinX logo and what a console system has.
// The logo is the one on the console banner.  A user's own
// ~/.config/fastfetch/config.jsonc takes precedence over this file.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/fastfetch/logos/freelinx.txt",
    "color": { "1": "red", "2": "yellow" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "color": { "keys": "cyan", "title": "cyan" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "locale",
    "break",
    "colors"
  ]
}
