#!/bin/sh
# FreeLinX /sbin/flxconsole - a login shell on every console this system has.
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 FreeLinX OS Project.
#
# The console a system has is named on its kernel command line, not in a file
# this script can read, so it probes for the names and opens what it finds.
# Both base images and every installed system are booted with
#
#     console=ttyS0,115200 console=tty0
#
# which is two consoles: the serial line and the virtual terminal.  Both of
# them receive everything the kernel prints.  Only the last one is
# /dev/console - console= is last-one-wins - so the screen is what /init and
# the services it starts write to.  A shell on both is the point: the serial
# line is what a headless install is driven over, and the virtual terminal is
# what a person at the machine sees.
#
# tty0 last is deliberate.  With it last on a serial line, /dev/console is a
# device that may not be wired to anything, and every write to it fails; and
# with it first, init's output went to a terminal nobody was looking at while
# the boot log scrolled past on the screen above the prompt.
#
# Both images and the installed system use this one script.  It was previously
# a second copy of this logic written into the initramfs by scripts/initramfs.sh,
# because src/rootfs/var/service/shell/run waited for /dev/ttyS1 - a name no
# limine.conf or installed limine.conf in this tree ever asks for:
#
#     #!/bin/sh
#     [ -e /dev/ttyS1 ] || exit 1
#     exec /bin/sh -l < /dev/ttyS1 > /dev/ttyS1 2>&1
#
# runsvdir restarts a service that exits, so on a system with no /dev/ttyS1 that
# script restarted forever and the installed system came up with no way in: no
# prompt on the screen, none on the serial line, and nothing in the log but the
# same two lines repeating.  It looked exactly like a hang.

set -u

# The shell a person gets at the prompt, named by /etc/flx-shell.  base writes
# that file as /bin/mksh - mksh for people, /bin/sh for scripts - and sets root's
# login shell to match; the desktop tree has no such file and its /bin/sh is
# what this falls back to.  Reading the file rather than hardcoding a name is
# what lets the two agree: they were separate decisions written down twice, and
# when only one of them changed, the console quietly gave a different shell from
# the one /etc/passwd said root had.
LOGIN_SHELL=$(cat /etc/flx-shell 2>/dev/null || : )
[ -n "$LOGIN_SHELL" ] && [ -x "$LOGIN_SHELL" ] || LOGIN_SHELL=/bin/sh

# setsid, for giving a shell a controlling terminal.  /usr/bin/setsid where the
# image has one; where it does not, toybox carries the applet and this tree
# deliberately does not symlink applets onto PATH - a NetBSD command of the same
# name is a different program - so it is reached through the multiplexer.
# Two words, which is why it is not quoted where it is used.
SETSID=
if [ -x /usr/bin/setsid ]; then
	SETSID='/usr/bin/setsid'
elif [ -x /bin/toybox ]; then
	SETSID='/bin/toybox setsid'
fi

# getty and login, for a system that has been installed.
#
# On the live medium a root shell is the entire point: there is nothing
# installed to log in to, and the person at the keyboard is supposed to be
# root.  On an installed system that is a hole.  xsetup asked for a root
# password and wrote it into /etc/shadow, and a console that opens a shell
# without asking makes that password decorative - anyone who can reach the
# keyboard or the serial port is root, and the serial port is often on a
# network or a hypervisor console.  1.0.8 through 1.0.11 asked for a login here
# and this does not, which is a regression and not a simplification.
#
# So: /etc/flx-installed decides.  It exists only once setup-disk has run.
#
# util-linux's getty and login where the image has them, toybox's applets where
# it does not - the tree does not symlink applets onto PATH, because a NetBSD
# command of the same name is a different program.
GETTY=
LOGINPROG=
if [ -x /usr/bin/getty ]; then
	GETTY=/usr/bin/getty
	# the toybox package links its login into /usr/bin, next to getty
	[ -x /usr/bin/login ] && LOGINPROG=/usr/bin/login
	[ -x /usr/libexec/toybox/login ] && LOGINPROG=/usr/libexec/toybox/login
	[ -x /bin/login ] && LOGINPROG=/bin/login
elif [ -x /bin/toybox ]; then
	GETTY='/bin/toybox getty'
	LOGINPROG='/bin/toybox login'
fi

export TERM=${TERM:-linux}
export SHELL=$LOGIN_SHELL
export HOME=/root
export USER=root
export LOGNAME=root
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# The virtual terminals worth having.  tty1 is the one console= names; tty2 and
# tty3 are here so a second session is a keypress away rather than a reboot.
# A fixed list rather than a glob over /dev/tty[0-9]: a name with no device
# under it is skipped, and globbing would also pick up the kernel's "tty" and
# "console" names.
TTYS='/dev/ttyS0 /dev/tty1 /dev/tty2 /dev/tty3'

# How long to keep looking for a console.  devtmpfs creates the nodes as the
# kernel probes them and runsvdir starts this service immediately, so on a cold
# boot there is briefly no ttyS0 to open.  A service that exits immediately is
# restarted forever, which fills the log and never succeeds; waiting is the only
# thing that helps, and 50 seconds is longer than any probe takes.
WAIT_TRIES=50

# Once there is one console, keep looking this many more seconds for the others.
# tty2 and tty3 are allocated after tty1 and can land a moment later, and a
# console that is never opened is a console you have to reboot to get.
SETTLE_TRIES=5

pids=
opened=
started=

kill_children() {
	trap - TERM INT HUP EXIT
	for p in $pids; do
		kill "$p" 2>/dev/null || :
	done
}
trap kill_children TERM INT HUP
trap kill_children EXIT

# open_console TTY - put a login shell on TTY, in the background.
#
# Not exec: the parent has to keep running to hold the other consoles open and
# to notice when they have all gone away.
#
# /etc/motd is the banner, and this is the only thing that can write it: base
# has no getty and no login, so from boot to prompt there is nothing else on a
# console.  It goes to the terminal it belongs to, never to stdout - stdout is
# inherited from /init, whose stdout is the kernel console, and the kernel
# console is the *last* console= on the command line, which is tty0.  Written to
# stdout, the banner would be handed to a screen that a runit service has already
# been given a shell on, one shell per terminal, and would print once per console
# there is rather than once per person.
open_console() {
	# Clear before the banner.  The boot log has just gone past on this same
	# terminal and there is no more coming, so leaving it there means the
	# banner - the only thing a person is meant to read here - is pushed off
	# the bottom of the screen and out of sight.  The log is still on the
	# serial line, which is where it is meant to be read.
	#
	# ESC[H ESC[2J: cursor home, then erase the display including scrollback.
	# ESC[2J alone erases from the cursor down, and the cursor is wherever the
	# log finished, so the log stays on screen.
	printf '\033[H\033[2J' >"$1" 2>/dev/null || :
	cat /etc/motd >"$1" 2>/dev/null || :
	# An installed system asks for a login.  See GETTY above for why, and for
	# why the answer is never "carry on and open a shell anyway": that is the
	# hole.  A system with no getty gets a console that says so, which is a
	# nuisance, rather than one that hands out root.
	if [ -e /etc/flx-installed ]; then
		if [ -n "$GETTY" ] && [ -n "$LOGINPROG" ]; then
			case $1 in
			*/ttyS[0-9]*) _baud=115200; _term=vt100 ;;
			*)             _baud=38400;  _term=linux ;;
			esac
			# Respawned here, per console: getty exits when the session it
			# started logs out, and this script only exits once every
			# console has, so without the loop the first logout left that
			# console with no login prompt until all the others logged out.
			(
				while :; do
					# shellcheck disable=SC2086  # GETTY may be two words
					$GETTY -l "$LOGINPROG" "$_baud" "$1" "$_term"
					sleep 1
				done
			) &
		else
			# No getty on a system that is installed.  The console is left
			# alone rather than handed a root shell, because that is the hole
			# this branch exists to close, and the way out is the boot menu's
			# rescue entry, which is a deliberate choice by a person at the
			# keyboard rather than the default state of every console.
			printf 'FreeLinX: %s is installed and has no getty, so no login is started on it.\n' "$1" >&2
			printf 'FreeLinX: use the boot menu'"'"'s rescue shell, or fix getty on this medium.\n' >&2
			opened="$opened $1"
			return 0
		fi
		pids="$pids $!"
		opened="$opened $1"
		started=yes
		return 0
	fi
	# cd /root: runsvdir starts a service in the service directory, so a shell
	# started from here opens in /var/service/shell.  Both services that
	# flxconsole replaced did this before starting their shell, and losing it
	# with them is why the prompt used to appear in the wrong place.
	cd /root 2>/dev/null || cd /
	# cd /root: runsvdir starts a service in the service directory, so a shell
	# started from here opens in /var/service/shell.  Both services that
	# flxconsole replaced did this before starting their shell, and losing it
	# with them is why the prompt used to appear in the wrong place.
	cd /root 2>/dev/null || cd /
	# setsid -c: a shell needs the terminal to be its controlling terminal, and
	# a runit service has none.  Without this the shell is in a session with no
	# terminal in it and says so on every start:
	#
	#     /bin/mksh: No controlling tty: open /dev/tty: No such device or address
	#     /bin/mksh: warning: won't have full job control
	#
	# and under those two lines Ctrl-C reaches nothing, because there is no
	# terminal to raise SIGINT from and no foreground job for it to interrupt.
	# Both services flxconsole replaced ran `setsid -c` for exactly this, and
	# losing it with them is a regression rather than a simplification.
	if [ -n "$SETSID" ]; then
		# shellcheck disable=SC2086  # SETSID may be two words
		$SETSID -c "$LOGIN_SHELL" -l <"$1" >"$1" 2>&1 &
	else
		"$LOGIN_SHELL" -l <"$1" >"$1" 2>&1 &
	fi
	pids="$pids $!"
	opened="$opened $1"
	started=yes
}

# open_new - open a shell on every console that has appeared and has not got one.
open_new() {
	for tty in $TTYS; do
		case "$opened" in
		*" $tty "*) continue ;;
		esac
		[ -c "$tty" ] || continue
		open_console "$tty"
	done
}

i=0
while :; do
	open_new
	if [ -n "$started" ]; then
		[ "$i" -ge "$SETTLE_TRIES" ] && break
	else
		[ "$i" -ge "$WAIT_TRIES" ] && break
	fi
	i=$((i + 1))
	sleep 1
done

if [ -z "$started" ]; then
	echo "FreeLinX: no console found (tried: $TTYS) after ${WAIT_TRIES}s" >&2
	echo "FreeLinX: nothing is running a login shell; the system booted with no prompt." >&2
	exit 1
fi

# Wait for every shell.  When the last one exits, exit too, so runsvdir starts a
# fresh set rather than leaving the service nominally up with no prompt.
wait
exit 0
