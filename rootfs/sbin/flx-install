#!/bin/sh
# FreeLinX Bare-Metal OS Installer (flx-install)
#
# Fully autonomous, non-GNU installer for FreeLinX.
# Installs to bare-metal disks with UEFI (GPT) and Legacy BIOS support using Limine.
#
# Copyright (c) 2026 FreeLinX OS Project.
# SPDX-License-Identifier: BSD-2-Clause

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m' # No Color

echo ""
echo "${CYAN}${BOLD}==============================================================${NC}"
echo "${CYAN}${BOLD}       FreeLinX Bare-Metal Operating System Installer         ${NC}"
echo "${CYAN}${BOLD}        No-GNU | Static Musl | Linux 6.6 | X11 Retro          ${NC}"
echo "${CYAN}${BOLD}==============================================================${NC}"
echo ""

if [ "$(id -u)" -ne 0 ]; then
    echo "${RED}Error: flx-install must be run as root.${NC}" >&2
    exit 1
fi

# Locate required utilities
command -v flx-part >/dev/null 2>&1 || {
    if [ -x /sbin/flx-part ]; then PATH="$PATH:/sbin";
    elif [ -x /usr/bin/flx-part ]; then PATH="$PATH:/usr/bin";
    else echo "${RED}Error: flx-part utility not found.${NC}" >&2; exit 1; fi
}

MKFS_FAT=""
if command -v mkfs.fat >/dev/null 2>&1; then MKFS_FAT="mkfs.fat"
elif command -v mkfs.vfat >/dev/null 2>&1; then MKFS_FAT="mkfs.vfat"
elif [ -x /sbin/mkfs.fat ]; then MKFS_FAT="/sbin/mkfs.fat"
fi

MKFS_EXT4=""
if command -v mkfs.ext4 >/dev/null 2>&1; then MKFS_EXT4="mkfs.ext4"
elif command -v mke2fs >/dev/null 2>&1; then MKFS_EXT4="mke2fs -t ext4"
elif [ -x /sbin/mke2fs ]; then MKFS_EXT4="/sbin/mke2fs -t ext4"
fi

if [ -z "$MKFS_FAT" ] || [ -z "$MKFS_EXT4" ]; then
    echo "${RED}Error: Filesystem creation tools (mkfs.fat, mkfs.ext4) not found.${NC}" >&2
    exit 1
fi

TARGET_DISK="$1"

if [ -z "$TARGET_DISK" ]; then
    echo "${YELLOW}Available Block Storage Devices:${NC}"
    echo "--------------------------------------------------------------"
    i=1
    DISKS=""
    for blk in /sys/block/*; do
        devname=$(basename "$blk")
        case "$devname" in
            loop*|ram*|dm-*|sr*|zram*) continue ;;
        esac
        
        devpath="/dev/$devname"
        [ -b "$devpath" ] || continue
        
        size_sectors=$(cat "$blk/size" 2>/dev/null || echo 0)
        size_gb=$(awk "BEGIN {printf \"%.1f\", $size_sectors * 512 / 1073741824}")
        
        model="Unknown"
        if [ -r "$blk/device/model" ]; then
            model=$(cat "$blk/device/model" | tr -d '\r\n' | sed -e 's/^[ \t]*//' -e 's/[ \t]*$//')
        fi
        
        echo "  ${BOLD}[$i]${NC} $devpath  (${size_gb} GB - $model)"
        DISKS="$DISKS $devpath"
        i=$((i + 1))
    done
    echo "--------------------------------------------------------------"
    
    if [ -z "$DISKS" ]; then
        echo "${RED}No installable block devices detected!${NC}"
        exit 1
    fi

    printf "\nEnter target disk path (e.g. /dev/sda, /dev/vda) or number: "
    read -r CHOICE
    
    if [ -b "$CHOICE" ]; then
        TARGET_DISK="$CHOICE"
    else
        idx=1
        for d in $DISKS; do
            if [ "$idx" = "$CHOICE" ]; then
                TARGET_DISK="$d"
                break
            fi
            idx=$((idx + 1))
        done
    fi
fi

if [ ! -b "$TARGET_DISK" ]; then
    echo "${RED}Error: Selected target '$TARGET_DISK' is not a valid block device!${NC}" >&2
    exit 1
fi

echo ""
echo "${RED}${BOLD}!!!!!!!!!!!!!!!!!!!!!!!!!! WARNING !!!!!!!!!!!!!!!!!!!!!!!!!!!${NC}"
echo "${RED}${BOLD}ALL DATA on $TARGET_DISK will be PERMANENTLY ERASED!${NC}"
echo "${RED}${BOLD}Partition table, files, and operating systems will be replaced!${NC}"
echo "${RED}${BOLD}!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!${NC}"
printf "\nType ${BOLD}YES${NC} in capital letters to proceed: "
read -r CONFIRM

if [ "$CONFIRM" != "YES" ]; then
    echo "Installation cancelled."
    exit 0
fi

echo ""
echo "${GREEN}>>> Step 1/6: Partitioning $TARGET_DISK with flx-part (GPT)...${NC}"

# Unmount any existing partitions on this disk
for part in "${TARGET_DISK}"* "${TARGET_DISK}p"*; do
    if [ -b "$part" ]; then
        umount "$part" 2>/dev/null || :
    fi
done

flx-part --create-standard "$TARGET_DISK"
command -v partprobe >/dev/null 2>&1 && partprobe "$TARGET_DISK" 2>/dev/null || :
sleep 1

# Determine partition names
case "$TARGET_DISK" in
    *[0-9])
        PART1="${TARGET_DISK}p1"
        PART2="${TARGET_DISK}p2"
        ;;
    *)
        PART1="${TARGET_DISK}1"
        PART2="${TARGET_DISK}2"
        ;;
esac

# Fallback wait for device nodes
timeout=10
while [ ! -b "$PART1" ] || [ ! -b "$PART2" ]; do
    sleep 0.5
    timeout=$((timeout - 1))
    [ "$timeout" -le 0 ] && break
done

if [ ! -b "$PART1" ] || [ ! -b "$PART2" ]; then
    echo "${RED}Error: Partition device nodes ($PART1, $PART2) not found after partitioning.${NC}" >&2
    exit 1
fi

echo "${GREEN}>>> Step 2/6: Formatting Filesystems...${NC}"
echo "Formatting ESP partition ($PART1) as FAT32..."
$MKFS_FAT -F 32 -n "FLX_BOOT" "$PART1"

echo "Formatting Root partition ($PART2) as Ext4..."
$MKFS_EXT4 -F -L "FLX_ROOT" "$PART2"

echo "${GREEN}>>> Step 3/6: Mounting Target Filesystem...${NC}"
MNT_DIR="/mnt/flx_target"
mkdir -p "$MNT_DIR"
mount -t ext4 "$PART2" "$MNT_DIR" || toybox mount -t ext4 "$PART2" "$MNT_DIR"
mkdir -p "$MNT_DIR/boot/efi"
mount -t vfat "$PART1" "$MNT_DIR/boot/efi" || toybox mount -t vfat "$PART1" "$MNT_DIR/boot/efi"

echo "${GREEN}>>> Step 4/6: Deploying FreeLinX Operating System...${NC}"
for d in bin etc home lib root sbin usr var; do
    if [ -d "/$d" ]; then
        printf "Deploying /%s... " "$d"
        (cd / && tar -cf - "$d") | (cd "$MNT_DIR" && tar -xf - 2>/dev/null || true)
        echo "done."
    fi
done

# Create necessary virtual mount directories
mkdir -p "$MNT_DIR/proc" "$MNT_DIR/sys" "$MNT_DIR/dev" "$MNT_DIR/run" \
         "$MNT_DIR/tmp" "$MNT_DIR/mnt" "$MNT_DIR/media"
chmod 1777 "$MNT_DIR/tmp"
chmod 0755 "$MNT_DIR/run"

echo "${GREEN}>>> Step 5/6: Configuring Bootloader (Limine UEFI + BIOS)...${NC}"
# Copy kernel
KERNEL_SRC=""
for k in /boot/vmlinuz /kernel/bzImage /vmlinuz; do
    if [ -f "$k" ]; then
        KERNEL_SRC="$k"
        break
    fi
done

mkdir -p "$MNT_DIR/boot"
if [ -n "$KERNEL_SRC" ]; then
    echo "Installing kernel from $KERNEL_SRC..."
    cp "$KERNEL_SRC" "$MNT_DIR/boot/vmlinuz"
    cp "$KERNEL_SRC" "$MNT_DIR/boot/efi/vmlinuz"
else
    echo "${YELLOW}Warning: Kernel not found in live environment. Ensure /boot/vmlinuz is present.${NC}"
fi

# Copy initramfs if present
for initrd in /boot/initramfs.img.gz /initramfs.img.gz; do
    if [ -f "$initrd" ]; then
        cp "$initrd" "$MNT_DIR/boot/initramfs.img.gz"
        cp "$initrd" "$MNT_DIR/boot/efi/initramfs.img.gz"
        break
    fi
done

# Install Limine UEFI Bootloader
LIMINE_DIR="/usr/share/limine"
if [ -d "$LIMINE_DIR" ]; then
    mkdir -p "$MNT_DIR/boot/efi/EFI/BOOT"
    if [ -f "$LIMINE_DIR/BOOTX64.EFI" ]; then
        cp "$LIMINE_DIR/BOOTX64.EFI" "$MNT_DIR/boot/efi/EFI/BOOT/BOOTX64.EFI"
        cp "$LIMINE_DIR/BOOTX64.EFI" "$MNT_DIR/boot/efi/BOOTX64.EFI"
        echo "Installed Limine UEFI Bootloader (BOOTX64.EFI)"
    fi
    if [ -f "$LIMINE_DIR/limine-bios.sys" ]; then
        cp "$LIMINE_DIR/limine-bios.sys" "$MNT_DIR/boot/limine-bios.sys"
        cp "$LIMINE_DIR/limine-bios.sys" "$MNT_DIR/boot/efi/limine-bios.sys"
    fi
fi

# Install Limine BIOS stage if utility present
if command -v limine >/dev/null 2>&1; then
    echo "Deploying Limine BIOS stage to $TARGET_DISK..."
    limine bios-install "$TARGET_DISK" 2>/dev/null || :
fi

# Generate Limine configuration
cat > "$MNT_DIR/boot/efi/limine.conf" << EOF
timeout: 5
default_entry: 1
interface_branding: FreeLinX Bare-Metal OS

/FreeLinX (Linux 6.6 Musl X11 Desktop)
    protocol: linux
    kernel_path: boot():/vmlinuz
    cmdline: root=$PART2 rw quiet loglevel=3 console=tty1 console=ttyS0

/FreeLinX (Rescue Shell)
    protocol: linux
    kernel_path: boot():/vmlinuz
    cmdline: root=$PART2 rw init=/bin/sh console=tty1 console=ttyS0
EOF

# Copy config to standard locations
cp "$MNT_DIR/boot/efi/limine.conf" "$MNT_DIR/boot/limine.conf"
mkdir -p "$MNT_DIR/boot/efi/EFI/BOOT"
cp "$MNT_DIR/boot/efi/limine.conf" "$MNT_DIR/boot/efi/EFI/BOOT/limine.conf"

echo "${GREEN}>>> Step 6/6: Generating /etc/fstab & System Config...${NC}"
cat > "$MNT_DIR/etc/fstab" << EOF
# /etc/fstab: FreeLinX static filesystem table
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
$PART2          /               ext4    defaults,noatime                0 1
$PART1          /boot/efi       vfat    defaults,noatime,umask=0077     0 2
proc            /proc           proc    defaults                        0 0
sysfs           /sys            sysfs   defaults                        0 0
devpts          /dev/pts        devpts  gid=5,mode=620                  0 0
tmpfs           /run            tmpfs   defaults,nosuid,nodev,mode=0755 0 0
tmpfs           /tmp            tmpfs   defaults,nosuid,nodev           0 0
EOF

# Hostname setup
[ -f "$MNT_DIR/etc/hostname" ] || echo "freelinx" > "$MNT_DIR/etc/hostname"

# Doas setup
chmod 0400 "$MNT_DIR/etc/doas.conf" 2>/dev/null || :
chmod 4755 "$MNT_DIR/usr/bin/doas" 2>/dev/null || :

# Unmounting
echo "Syncing data to disk..."
sync
umount "$MNT_DIR/boot/efi"
umount "$MNT_DIR"
rmdir "$MNT_DIR" 2>/dev/null || :

echo ""
echo "${GREEN}${BOLD}==============================================================${NC}"
echo "${GREEN}${BOLD}        FreeLinX successfully installed to $TARGET_DISK!        ${NC}"
echo "${GREEN}${BOLD}==============================================================${NC}"
echo "You can now reboot your system into FreeLinX."
echo ""
