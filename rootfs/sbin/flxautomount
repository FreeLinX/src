#!/bin/sh
# FreeLinX Storage Auto-Mounter
# Invoked by mdevd / mdev upon block device addition or removal.
# The partition labeled FLX_HOME is the persistent /home; everything else
# is treated as removable media and mounted under /media.
#
# Copyright (c) 2026 FreeLinX OS Project.
# SPDX-License-Identifier: BSD-2-Clause

set -e

# While flxinstall is partitioning/formatting/mounting the target disk,
# mdevd hotplug events fire for the freshly created partitions.  flxinstall
# creates /run/flxinstall-active so this automounter steps aside and never
# races the installer (which otherwise ends in "Device or resource busy").
if [ -e /run/flxinstall-active ]; then
    exit 0
fi

MDEV="${MDEV:-$1}"
ACTION="${ACTION:-add}"

[ -z "$MDEV" ] && exit 0

DEVNODE="/dev/$MDEV"
MNTPOINT="/media/$MDEV"

log_msg() {
    echo "FreeLinX automount: $1" >&2
    [ -w /dev/ttyS0 ] && echo "FreeLinX automount: $1" > /dev/ttyS0 2>/dev/null || :
}

case "$ACTION" in
    add)
        [ -b "$DEVNODE" ] || exit 0

        # Ignore non-partitioned raw disks if partitions exist
        if [ -d "/sys/class/block/$MDEV" ]; then
            # If disk has partitions and this is the root disk itself, don't mount raw disk
            if ls "/sys/class/block/$MDEV/"* >/dev/null 2>&1; then
                for sub in "/sys/class/block/$MDEV/"*"$MDEV"*; do
                    [ -d "$sub" ] && exit 0 || :
                done
            fi
        fi

        # Determine filesystem type
        FSTYPE=""
        FS_LABEL=""
        if command -v blkid >/dev/null 2>&1; then
            OUT="$(blkid "$DEVNODE" 2>/dev/null || true)"
            FSTYPE=$(echo "$OUT" | grep -o 'TYPE="[^"]*"' | cut -d'"' -f2 || true)
            FS_LABEL=$(echo "$OUT" | grep -o 'LABEL="[^"]*"' | cut -d'"' -f2 || true)
        fi

        # Persistent system overlay: FLX_SYS is mounted by /init (never here).
        # FLX_BOOT is the installed system's own EFI partition - not media.
        if [ "$FS_LABEL" = "FLX_SYS" ] || [ "$FS_LABEL" = "FLX_BOOT" ]; then
            exit 0
        fi

        # Persistent /home: the installed system's own FLX_HOME partition
        # (pinned by UUID in /etc/flx-disk) goes to /home.  On the live
        # system, or for any other disk that merely carries the label (a USB
        # stick), it is ordinary removable media below.
        HOME_PIN=$(sed -n 's/^FLX_HOME_UUID=\([0-9A-Fa-f-]*\)$/\1/p' /etc/flx-disk 2>/dev/null | head -1)
        FS_UUID=$(echo "$OUT" | grep -o ' UUID="[^"]*"' | cut -d'"' -f2 || true)
        if [ "$FS_LABEL" = "FLX_HOME" ] && [ -e /etc/flx-installed ] &&
           { [ -z "$HOME_PIN" ] || [ "$FS_UUID" = "$HOME_PIN" ]; }; then
            mkdir -p /home
            if ! grep -qs ' /home ' /proc/mounts; then
                # The bundled mount requires an explicit -t (no auto-detect);
                # fall back to guessing from blkid, then common filesystems.
                FSTYPE_OPT=""
                [ -n "$FSTYPE" ] && FSTYPE_OPT="-t $FSTYPE"
                if mount $FSTYPE_OPT -o defaults,noatime,nodev,nosuid "$DEVNODE" /home 2>/dev/null ||
                   mount -o defaults,noatime,nodev,nosuid "$DEVNODE" /home 2>/dev/null; then
                    log_msg "Mounted $DEVNODE (FSTYPE=$FSTYPE, LABEL=FLX_HOME) -> /home"
                else
                    log_msg "Failed to mount FLX_HOME partition $DEVNODE at /home"
                fi
            else
                log_msg "/home already mounted; skipping FLX_HOME device $DEVNODE"
            fi
            exit 0
        fi

        mkdir -p "$MNTPOINT"
        MOUNT_OPTS="defaults,noatime,nodev,nosuid"

        if [ "$FSTYPE" = "vfat" ] || [ "$FSTYPE" = "fat" ]; then
            MOUNT_OPTS="$MOUNT_OPTS,umask=000,iocharset=utf8"
        elif [ "$FSTYPE" = "ntfs" ]; then
            MOUNT_OPTS="$MOUNT_OPTS,umask=000"
        fi

        FSTYPE_OPT=""
        [ -n "$FSTYPE" ] && FSTYPE_OPT="-t $FSTYPE"

        if mount $FSTYPE_OPT -o "$MOUNT_OPTS" "$DEVNODE" "$MNTPOINT" 2>/dev/null; then
            log_msg "Mounted $DEVNODE ($FSTYPE) -> $MNTPOINT"
        else
            rmdir "$MNTPOINT" 2>/dev/null || :
        fi
        ;;

    remove)
        if grep -qs "$MNTPOINT" /proc/mounts; then
            umount -l "$MNTPOINT" 2>/dev/null || :
            rmdir "$MNTPOINT" 2>/dev/null || :
            log_msg "Unmounted $MNTPOINT"
        else
            rmdir "$MNTPOINT" 2>/dev/null || :
        fi
        ;;
esac

exit 0
