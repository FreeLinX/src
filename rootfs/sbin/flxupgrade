#!/bin/sh
# FreeLinX upgrade (flxupgrade): bring an installed FreeLinX to the release
# this live system runs, without touching the user's data.
#
#   doas flxupgrade [-y] [disk]
#
# Run it from the live ISO of the new release.  It finds the installed system
# (its FLX_BOOT and root partitions), replaces the system files on the root
# partition with this release's - /usr /bin /sbin /lib and /init - adds the
# files in /etc this release has and the installed one lacks, and puts this
# release's kernel and Limine on the boot partition.  Settings in /etc, users,
# packages installed with xpkg and /home stay.  Afterwards: doas xpkg upgrade.
#
# A system installed by 1.0.13-1.1.x ran from an image in RAM with its trees on
# a partition labelled FLX_SYS.  That partition already holds /usr /etc /var
# /root /bin /sbin /lib, so it becomes the root partition: the rest of / is
# added, it is relabelled FLX_ROOT, and the RAM image on the boot partition is
# removed.
#
# Copyright (c) 2026 FreeLinX OS Project.
# SPDX-License-Identifier: BSD-2-Clause
set -e

die() { echo "flxupgrade: $*" >&2; exit 1; }

YES=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        -y|--yes) YES=1; shift ;;
        -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) die "unknown option: $1" ;;
        *) break ;;
    esac
done
DISK="${1:-}"

[ "$(id -u)" -eq 0 ] || die "run it as root (doas flxupgrade)"
[ -e /etc/flx-installed ] && die "this is an installed system: boot the new release's live ISO and run flxupgrade there"
NEW=$(sed -n 's/^VERSION_ID="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/os-release)

find_label() { # label - a partition with it, on DISK when one was named
    blkid 2>/dev/null | grep "LABEL=\"$1\"" | cut -d: -f1 | while IFS= read -r d; do
        case "$d" in "$DISK"*) echo "$d" ;; esac
    done | head -1
}
uuid_of() { blkid "$1" 2>/dev/null | grep -o ' UUID="[^"]*"' | cut -d'"' -f2; }

BOOT_DEV=$(find_label FLX_BOOT)
[ -n "$BOOT_DEV" ] || die "no installed FreeLinX found (no FLX_BOOT partition${DISK:+ on $DISK})"
OLDMODEL=no
ROOT_DEV=$(find_label FLX_ROOT)
if [ -z "$ROOT_DEV" ]; then
    ROOT_DEV=$(find_label FLX_SYS)
    [ -n "$ROOT_DEV" ] && OLDMODEL=yes
fi
[ -n "$ROOT_DEV" ] || die "$BOOT_DEV has no FLX_ROOT (or FLX_SYS) partition next to it"
HOME_DEV=$(find_label FLX_HOME)

# The disk, and the BIOS boot partition on it, for Limine's BIOS stage.
_p=${BOOT_DEV##*/}
_d=$(cd -P "/sys/class/block/$_p/.." 2>/dev/null && pwd -P)
DISK_DEV=
[ -n "$_d" ] && [ -b "/dev/${_d##*/}" ] && DISK_DEV=/dev/${_d##*/}
[ -n "$DISK_DEV" ] || die "cannot tell which disk $BOOT_DEV is on"
part_index() { # partition device -> its number
    cat "/sys/class/block/${1##*/}/partition" 2>/dev/null
}

# gpt_partuuid DISK INDEX - the GPT unique GUID of a partition (what the
# kernel's root=PARTUUID= matches); see setup-disk.
gpt_partuuid() {
    _ss=$(cat "/sys/class/block/${1##*/}/queue/logical_block_size" 2>/dev/null || echo 512)
    # shellcheck disable=SC2046
    set -- "$1" "$2" $(dd if="$1" bs="$_ss" skip=1 count=1 2>/dev/null | od -An -v -tu1 |
		awk '{ for (i = 1; i <= NF; i++) printf "%d ", $i + 0 }')
    _disk=$1 _idx=$2
    shift 2
    [ "${1:-}" = 69 ] && [ "${2:-}" = 70 ] && [ "${3:-}" = 73 ] || return 1
    _lba=0 _i=7
    while [ "$_i" -ge 0 ]; do eval "_b=\${$((73 + _i))}"; _lba=$((_lba * 256 + _b)); _i=$((_i - 1)); done
    _esz=0 _i=3
    while [ "$_i" -ge 0 ]; do eval "_b=\${$((85 + _i))}"; _esz=$((_esz * 256 + _b)); _i=$((_i - 1)); done
    _g=$(dd if="$_disk" bs=1 skip=$((_lba * _ss + (_idx - 1) * _esz + 16)) count=16 2>/dev/null |
        od -An -v -tx1 | tr -d ' \n')
    [ "${#_g}" -eq 32 ] || return 1
    printf '%s\n' "$_g" | awk '{ s = $0
        printf "%s%s%s%s-%s%s-%s%s-%s-%s\n", substr(s,7,2), substr(s,5,2), substr(s,3,2), substr(s,1,2),
            substr(s,11,2), substr(s,9,2), substr(s,15,2), substr(s,13,2), substr(s,17,4), substr(s,21,12) }'
}
ROOT_PARTUUID=$(gpt_partuuid "$DISK_DEV" "$(part_index "$ROOT_DEV")") ||
    die "cannot read the partition GUID of $ROOT_DEV"

KERNEL_SRC=
for k in /boot/vmlinuz /boot/bzImage; do [ -f "$k" ] && KERNEL_SRC=$k && break; done
[ -n "$KERNEL_SRC" ] || die "this live system has no kernel in /boot to install"

MP=/mnt/flx_upgrade_boot
RP=/mnt/flx_upgrade_root
mkdir -p "$MP" "$RP"
trap 'umount "$MP" 2>/dev/null || :; umount "$RP" 2>/dev/null || :; rmdir "$MP" "$RP" 2>/dev/null || :' EXIT INT TERM
# The live session's automounter mounts every labeled partition it sees -
# this disk's FLX_ROOT at /media/vda3 and its FLX_HOME at /home among them -
# and e2fsck refuses a mounted filesystem, so the upgrade dies claiming
# filesystem errors that are not there.  Tell the automounter to step aside
# (the same flag setup-disk.sh uses) and unmount what it already holds, the
# way setup-disk.sh does before it partitions.  The partitions are mounted
# again below, at MP and RP.
: >/run/flxinstall-active
for _dev in "$BOOT_DEV" "$ROOT_DEV" "$HOME_DEV"; do
	[ -n "$_dev" ] || continue
	grep "^$_dev " /proc/mounts 2>/dev/null | cut -d ' ' -f 2 |
	while IFS= read -r _m; do umount "$_m" 2>/dev/null || :; done
done
mount -t vfat "$BOOT_DEV" "$MP" || die "cannot mount $BOOT_DEV"
e2fsck -p "$ROOT_DEV" >/dev/null 2>&1 || [ $? -le 1 ] || die "$ROOT_DEV has filesystem errors: run e2fsck $ROOT_DEV first"
mount -t ext4 "$ROOT_DEV" "$RP" || die "cannot mount $ROOT_DEV"
[ -d "$RP/etc" ] && [ -d "$RP/usr" ] || die "$ROOT_DEV does not hold a FreeLinX system"
OLD=$(sed -n 's/^VERSION_ID="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$RP/etc/os-release" 2>/dev/null)

echo "Installed FreeLinX ${OLD:-?} on $ROOT_DEV -> $NEW"
[ "$OLDMODEL" = yes ] &&
    echo "It runs from an image in RAM; it will run from $ROOT_DEV, like any installed system."
echo "System files are replaced; /etc settings, users, packages and /home stay."
if [ "$YES" != 1 ]; then
    printf "Continue? [y/N] "
    read -r a
    case "$a" in y|Y|yes|YES) ;; *) echo "Nothing was changed."; exit 1 ;; esac
fi

echo ">>> System files..."
# /usr /bin /sbin /lib and /init are replaced wholesale - that is what the
# release means by a new version - by copying over them, so a package
# installed with xpkg into /usr stays.  /etc is not replaced: only files this
# release has and the installed system lacks are added.
for d in usr bin sbin lib; do
    mkdir -p "$RP/$d"
    (cd / && tar cf - "$d") | (cd "$RP" && tar xpf -) || die "could not copy /$d"
done
cp -p /init "$RP/init"
(cd /etc && find . \( -type f -o -type l \) -print) | while IFS= read -r f; do
    [ -e "$RP/etc/$f" ] || [ -L "$RP/etc/$f" ] && continue
    mkdir -p "$RP/etc/$(dirname "$f")"
    cp -a "/etc/$f" "$RP/etc/$f" 2>/dev/null || :
done
# the release's identity is FreeLinX's, not the user's
cp -p /etc/os-release "$RP/etc/os-release"
[ -f /etc/flx-base-version ] && cp -p /etc/flx-base-version "$RP/etc/flx-base-version"
for x in "$RP/etc/issue" "$RP/etc/motd"; do
    [ -f "$x" ] && sed -i "s/ FreeLinX [0-9][0-9.]*/ FreeLinX $NEW/" "$x"
done
mkdir -p "$RP/boot"
cp "$KERNEL_SRC" "$RP/boot/vmlinuz.new" && mv "$RP/boot/vmlinuz.new" "$RP/boot/vmlinuz"

if [ "$OLDMODEL" = yes ]; then
    echo ">>> Making $ROOT_DEV the root partition..."
    # the rest of a root filesystem: mount points, and any top-level directory
    # this release has that the old seven trees did not
    for n in proc sys dev run tmp mnt media home; do mkdir -p "$RP/$n"; done
    chmod 1777 "$RP/tmp"
    for d in /*; do
        n=${d#/}
        case $n in proc|sys|dev|run|tmp|mnt|media|home|lost+found) continue ;; esac
        [ -e "$RP/$n" ] || [ -L "$RP/$n" ] || (cd / && tar cf - "$n") | (cd "$RP" && tar xpf -)
    done
    tune2fs -L FLX_ROOT "$ROOT_DEV" >/dev/null || die "cannot relabel $ROOT_DEV FLX_ROOT"
    rm -f "$RP/.flx-image-version"
fi
: > "$RP/etc/flx-installed"
ROOT_UUID=$(uuid_of "$ROOT_DEV")
HOME_UUID=$([ -n "$HOME_DEV" ] && uuid_of "$HOME_DEV" || :)
printf 'FLX_ROOT_UUID=%s\nFLX_HOME_UUID=%s\n' "$ROOT_UUID" "$HOME_UUID" > "$RP/etc/flx-disk"
{
    echo '# Written by flxupgrade.  / is mounted by the kernel (root=PARTUUID= in'
    echo '# limine.conf) and /home by /init, both by these UUIDs.'
    printf 'UUID=%s\t/\text4\tdefaults,noatime\t0 1\n' "$ROOT_UUID"
    [ -n "$HOME_UUID" ] && printf 'UUID=%s\t/home\text4\tdefaults,noatime\t0 2\n' "$HOME_UUID"
    printf 'tmpfs\t/tmp\ttmpfs\tmode=1777,nosuid,nodev\t0 0\n'
} > "$RP/etc/fstab"
sync

echo ">>> Kernel and boot loader..."
mkdir -p "$MP/boot" "$MP/EFI/BOOT"
cp "$KERNEL_SRC" "$MP/boot/bzImage.new" && mv "$MP/boot/bzImage.new" "$MP/boot/bzImage"
# the old RAM image, and its module overlay: nothing boots them any more
rm -f "$MP/boot/initramfs.img.gz" "$MP/boot/kmods.cpio"
L=/usr/share/limine
[ -f "$L/BOOTX64.EFI" ] && { cp "$L/BOOTX64.EFI" "$MP/EFI/BOOT/BOOTX64.EFI"; cp "$L/BOOTX64.EFI" "$MP/BOOTX64.EFI"; }
[ -f "$L/limine-bios.sys" ] && { cp "$L/limine-bios.sys" "$MP/boot/limine-bios.sys"; cp "$L/limine-bios.sys" "$MP/limine-bios.sys"; }
CMD="root=PARTUUID=$ROOT_PARTUUID rootfstype=ext4 rootwait ro init=/init console=ttyS0,115200 console=tty0"
cat > "$MP/limine.conf" <<EOF
# Written by flxupgrade.
timeout: 3
serial: yes
textmode: yes
interface_branding: FreeLinX $NEW

/FreeLinX $NEW
    protocol: linux
    kernel_path: boot():/boot/bzImage
    cmdline: $CMD

/Rescue shell
    protocol: linux
    kernel_path: boot():/boot/bzImage
    cmdline: $CMD flx.rescue=1
EOF
cp "$MP/limine.conf" "$MP/boot/limine.conf"
cp "$MP/limine.conf" "$MP/EFI/BOOT/limine.conf"
# The BIOS stage in the disk's first sector and limine-bios.sys are two halves
# of one Limine and have to be the same version, so it is written again.
if command -v limine >/dev/null 2>&1 && command -v flxpart >/dev/null 2>&1; then
    bios_i=$(flxpart --show "$DISK_DEV" 2>/dev/null |
        sed -n 's/^ *\([0-9][0-9]*\): .*48616821-4964-6F6E-744E-656564454649 *$/\1/p' | head -1)
    if [ -n "$bios_i" ]; then
        limine bios-install "$DISK_DEV" "$bios_i" >/dev/null 2>&1 ||
            echo "flxupgrade: warning: limine bios-install failed on $DISK_DEV; the disk may boot on UEFI only" >&2
    else
        echo "flxupgrade: warning: no BIOS boot partition on $DISK_DEV; it boots on UEFI only" >&2
    fi
fi
sync
echo ""
echo "Done: FreeLinX $NEW is installed on $ROOT_DEV."
echo "Reboot into it (remove the live medium), then run"
echo "  doas xpkg upgrade"
echo "to bring the packages up to date."
