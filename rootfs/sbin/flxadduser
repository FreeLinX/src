#!/bin/sh
# FreeLinX User Creation Utility (flxadduser)
#
# Adds desktop users with proper group memberships (wheel, video, audio, input, disk)
# and seeds their retro desktop configuration.
#
# Copyright (c) 2026 FreeLinX OS Project.
# SPDX-License-Identifier: BSD-2-Clause

set -e

if [ "$(id -u)" -ne 0 ]; then
    echo "Error: flxadduser must be run as root." >&2
    exit 1
fi

NEW_USER="$1"
if [ -z "$NEW_USER" ]; then
    printf "Enter new username: "
    read -r NEW_USER
fi

[ -z "$NEW_USER" ] && { echo "Error: Username cannot be empty." >&2; exit 1; }

# Validate username format
case "$NEW_USER" in
    *[!a-z0-9_-]*|[0-9-]*|?????????????????????????????????*)
        echo "Error: Invalid username '$NEW_USER'. Use up to 32 lowercase letters, digits, '_' or '-', starting with a letter or '_'." >&2
        exit 1
        ;;
esac

# Check if the name is taken (a user, or a group such as wheel)
if grep -qs "^$NEW_USER:" /etc/passwd /etc/group; then
    echo "Error: User or group '$NEW_USER' already exists." >&2
    exit 1
fi

# Find next available UID >= 1000
NEXT_UID=1000
if [ -r /etc/passwd ]; then
    MAX_UID=$(awk -F: '$3 >= 1000 && $3 < 60000 {if ($3 > max) max=$3} END {print max}' /etc/passwd)
    if [ -n "$MAX_UID" ]; then
        NEXT_UID=$((MAX_UID + 1))
    fi
fi

USER_GID="$NEXT_UID"
while grep -qs "^[^:]*:[^:]*:$USER_GID:" /etc/group; do
    USER_GID=$((USER_GID + 1))
done
HOME_DIR="/home/$NEW_USER"

# Add entry to /etc/passwd, and a locked one to /etc/shadow (passwd below
# sets the password; without a shadow line it has nothing to update)
_ushell=$(cat /etc/flx-shell 2>/dev/null); [ -x "${_ushell:-/nonexistent}" ] || _ushell=/bin/sh
echo "$NEW_USER:x:$NEXT_UID:$USER_GID:$NEW_USER:$HOME_DIR:$_ushell" >> /etc/passwd
if [ -f /etc/shadow ] && ! grep -q "^$NEW_USER:" /etc/shadow; then
    echo "$NEW_USER:!:$(( $(date +%s) / 86400 )):0:99999:7:::" >> /etc/shadow
fi

# Add primary group to /etc/group
echo "$NEW_USER:x:$USER_GID:" >> /etc/group

# Add to the desktop groups flxinstall uses.  Not "disk": raw block device
# access is root in all but name.  Groups the system lacks are skipped.
for grp in wheel video audio storage input users; do
    grep -q "^$grp:" /etc/group || continue
    awk -F: -v g="$grp" -v u="$NEW_USER" 'BEGIN { OFS = ":" }
        $1 == g { $4 = ($4 == "" ? u : $4 "," u) } { print }' /etc/group > /etc/group.flx &&
        cat /etc/group.flx > /etc/group && rm -f /etc/group.flx
done

# Create home directory & skel
mkdir -p "$HOME_DIR/.config/openbox" "$HOME_DIR/.local/share" "$HOME_DIR/.cache"

# Copy Openbox retro desktop configs if available
if [ -d /root/.config/openbox ]; then
    cp -a /root/.config/openbox/* "$HOME_DIR/.config/openbox/" 2>/dev/null || :
fi
if [ ! -e "$HOME_DIR/.config/openbox/rc.xml" ]; then
    ln -sf /etc/xdg/openbox/rc.xml "$HOME_DIR/.config/openbox/rc.xml" 2>/dev/null || :
fi
if [ ! -e "$HOME_DIR/.config/openbox/menu.xml" ]; then
    ln -sf /etc/xdg/openbox/menu.xml "$HOME_DIR/.config/openbox/menu.xml" 2>/dev/null || :
fi
if [ -d /root/.config/xfe ]; then
    cp -a /root/.config/xfe "$HOME_DIR/.config/" 2>/dev/null || :
fi
if [ -f /root/.Xdefaults ]; then
    cp -a /root/.Xdefaults "$HOME_DIR/.Xdefaults" 2>/dev/null || :
fi

# Create default .profile
cat > "$HOME_DIR/.profile" << EOF
export SHELL=/bin/sh
export USER=$NEW_USER
export HOME=$HOME_DIR
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
export DISPLAY=:0
export ENV=\$HOME/.profile
EOF

# Set ownership and permissions
chown -R "$NEXT_UID:$USER_GID" "$HOME_DIR"
chmod 0750 "$HOME_DIR"

echo "FreeLinX: User '$NEW_USER' created (UID: $NEXT_UID, GID: $USER_GID)."
echo "Groups: $(id -Gn "$NEW_USER" 2>/dev/null || echo "wheel, video, audio, storage, input, users")"

# Prompt to set password
if command -v passwd >/dev/null 2>&1; then
    echo "Setting password for '$NEW_USER':"
    passwd "$NEW_USER" || echo "Note: Password can be set later with 'passwd $NEW_USER'."
fi
