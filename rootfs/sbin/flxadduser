#!/bin/sh
# FreeLinX User Creation Utility (flxadduser)
#
#   flxadduser NAME [--admin]
#
# Adds a user with a home directory, the groups a console user needs (video,
# audio, storage, input, users) and a password.  --admin also puts them in
# wheel, which doas.conf lets run commands as root: it is asked for, never
# given by default.
#
# Copyright (c) 2026 FreeLinX OS Project.
# SPDX-License-Identifier: BSD-2-Clause

set -e

if [ "$(id -u)" -ne 0 ]; then
    echo "Error: flxadduser must be run as root." >&2
    exit 1
fi

NEW_USER="${1:-}"
ADMIN=no
[ "${2:-}" = --admin ] && ADMIN=yes
if [ -z "$NEW_USER" ]; then
    printf "Enter new username: "
    read -r NEW_USER
fi

[ -z "$NEW_USER" ] && { echo "Error: Username cannot be empty." >&2; exit 1; }

# Validate username format
case "$NEW_USER" in
    *[!a-z0-9_-]*|[0-9-]*|?????????????????????????????????*)
        echo "Error: Invalid username '$NEW_USER'. Use up to 32 lowercase letters, digits, '_' or '-', starting with a letter or '_'." >&2
        exit 1
        ;;
esac

# Check if the name is taken (a user, or a group such as wheel)
if grep -qs "^$NEW_USER:" /etc/passwd /etc/group; then
    echo "Error: User or group '$NEW_USER' already exists." >&2
    exit 1
fi

# Find next available UID >= 1000
NEXT_UID=1000
if [ -r /etc/passwd ]; then
    MAX_UID=$(awk -F: '$3 >= 1000 && $3 < 60000 {if ($3 > max) max=$3} END {print max}' /etc/passwd)
    if [ -n "$MAX_UID" ]; then
        NEXT_UID=$((MAX_UID + 1))
    fi
fi

USER_GID="$NEXT_UID"
while grep -qs "^[^:]*:[^:]*:$USER_GID:" /etc/group; do
    USER_GID=$((USER_GID + 1))
done
HOME_DIR="/home/$NEW_USER"

# Add entry to /etc/passwd, and a locked one to /etc/shadow (passwd below
# sets the password; without a shadow line it has nothing to update)
_ushell=$(cat /etc/flx-shell 2>/dev/null); [ -x "${_ushell:-/nonexistent}" ] || _ushell=/bin/sh
echo "$NEW_USER:x:$NEXT_UID:$USER_GID:$NEW_USER:$HOME_DIR:$_ushell" >> /etc/passwd
if [ -f /etc/shadow ] && ! grep -q "^$NEW_USER:" /etc/shadow; then
    echo "$NEW_USER:!:$(( $(date +%s) / 86400 )):0:99999:7:::" >> /etc/shadow
fi

# Add primary group to /etc/group
echo "$NEW_USER:x:$USER_GID:" >> /etc/group

# The groups a console user needs.  Not "disk": raw block device access is
# root in all but name.  wheel only with --admin.  Groups the system lacks are
# skipped.
_groups='video audio storage input users'
[ "$ADMIN" = yes ] && _groups="wheel $_groups"
for grp in $_groups; do
    grep -q "^$grp:" /etc/group || continue
    awk -F: -v g="$grp" -v u="$NEW_USER" 'BEGIN { OFS = ":" }
        $1 == g { $4 = ($4 == "" ? u : $4 "," u) } { print }' /etc/group > /etc/group.flx &&
        cat /etc/group.flx > /etc/group && rm -f /etc/group.flx
done

mkdir -p "$HOME_DIR"
# The login shell reads /etc/profile, which sets PATH, the prompt and TERM;
# a user's own .profile only has to exist.
[ -e "$HOME_DIR/.profile" ] || printf '# %s\n' "$NEW_USER's login settings; /etc/profile is read first" >"$HOME_DIR/.profile"

chown -R "$NEXT_UID:$USER_GID" "$HOME_DIR"
chmod 0700 "$HOME_DIR"

echo "FreeLinX: user '$NEW_USER' created (uid $NEXT_UID, gid $USER_GID)."
echo "Groups: $(id -Gn "$NEW_USER" 2>/dev/null || echo "$_groups")"

echo "Setting the password for '$NEW_USER':"
/usr/bin/passwd "$NEW_USER" ||
    echo "The account is locked until a password is set: passwd $NEW_USER" >&2
