#!/bin/sh
# FreeLinX /init - runit-based init with a bootstrap rescue fallback.
#
# pid 1: mount the pseudo filesystems, bring up the hostname, then exec
# runsvdir to supervise the services in /var/service (dbus, ntpd, and the login
# shell). If runsvdir is missing we drop to a rescue shell.

set -eu

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

# FreeLinX default interactive shell for terminals (sakura/GTK apps read $SHELL).
export SHELL=/bin/sh
export TERM=xterm
export USER=root
export LOGNAME=root
export HOME=/root
export ENV=/etc/profile
# FreeLinX single session bus address (dbus service listens here).
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket

umask 022

# --- pseudo filesystems -----------------------------------------------------
mount -t proc     proc     /proc 2>/dev/null || :
mount -t sysfs    sysfs    /sys   2>/dev/null || :
mount -t devtmpfs devtmpfs /dev   2>/dev/null || :
# /run first: on an installed system / is still read-only here, so nothing may
# be created outside the filesystems this block mounts.
mount -t tmpfs    tmpfs    /run   2>/dev/null || :
mkdir -p /dev/pts /run/user /dev/shm
mount -t devpts -o gid=5,mode=0620,ptmxmode=0666 devpts /dev/pts 2>/dev/null || :
rm -f /dev/ptmx && ln -s /dev/pts/ptmx /dev/ptmx

# devtmpfs makes device nodes and nothing else, so /dev/fd and the three names
# under it are missing.  Several programs in this tree open /dev/stdin rather
# than file descriptor 0 - this system's sort does, and fails with
#
#   sort: /dev/stdin: No such file or directory
#
# on every pipeline it is given, which is not a sort problem to work around at
# each call site but a name that ought to be there.  /dev/fd is the Linux
# convention for it: a directory whose entries are /proc/self/fd/N.
[ -e /dev/fd ] || ln -s /proc/self/fd /dev/fd
for _fd in stdin stdout stderr; do
	[ -e "/dev/$_fd" ] || ln -s "/proc/self/fd/$_fd" "/dev/$_fd"
done
unset _fd

# --- the root filesystem ---------------------------------------------------------
# An installed system boots the way other systems do: the boot loader passes
# root=PARTUUID=... ro, the kernel mounts that partition read-only and runs this
# file from it as pid 1, and this checks the filesystem and remounts it
# read-write before anything writes to it.  On the live medium the root is the
# initramfs the kernel unpacked into RAM, and there is nothing to check.
ON_DISK=no
case $(awk '$2 == "/" { t = $3 } END { print t }' /proc/mounts) in
rootfs|ramfs|tmpfs|'') ;;
*) ON_DISK=yes ;;
esac
if [ "$ON_DISK" = yes ]; then
    # The kernel calls it /dev/root; the real node comes from its major:minor.
    _mm=$(awk '$5 == "/" { print $3; exit }' /proc/self/mountinfo)
    _rn=$(sed -n 's/^DEVNAME=//p' "/sys/dev/block/$_mm/uevent" 2>/dev/null)
    ROOT_DEV=${_rn:+/dev/$_rn}
    if [ -n "$ROOT_DEV" ] && [ -b "$ROOT_DEV" ] && [ -x /sbin/e2fsck ]; then
        # -p repairs what is safe to repair unattended.  1 means it did, 2
        # means the root filesystem was changed under the running kernel and
        # the machine has to restart; 4 and up need a person.
        _rc=0
        /sbin/e2fsck -p "$ROOT_DEV" || _rc=$?
        if [ "$_rc" -ge 4 ]; then
            echo "FreeLinX: the root filesystem $ROOT_DEV has errors e2fsck -p will not fix." >&2
            echo "FreeLinX: run  e2fsck $ROOT_DEV  in this shell, then reboot." >&2
            exec /bin/sh
        elif [ "$_rc" -ge 2 ]; then
            echo "FreeLinX: e2fsck repaired the root filesystem; restarting." >&2
            sync
            echo b > /proc/sysrq-trigger
        fi
    fi
    # this mount(8) wants the device and the mount point both
    mount -o remount,rw "${ROOT_DEV:-/dev/root}" / 2>/dev/null ||
        mount -t ext4 -o remount,rw "${ROOT_DEV:-/dev/root}" / || {
        echo "FreeLinX: the root filesystem would not mount read-write; starting a shell." >&2
        exec /bin/sh
    }
    # /tmp in RAM, as on most systems: emptied by every boot, never filling
    # the root partition.
    mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp 2>/dev/null || :
fi

# --- /var/log -----------------------------------------------------------------
# A runit service has nowhere to write but /dev/console otherwise, and
# /dev/console is the terminal the operator is typing on.  ntpd -d logs to
# stderr, dbus prints its bus address to stdout, and both of those landed on
# the keyboard.  /var is on the initramfs here and on FLX_VAR or tmpfs once
# installed, so this is a directory that has to exist at every boot.
mkdir -p /var/log
chmod 755 /var/log

# --- Device Manager (mdevd) & Driver Auto-Probe ------------------------------
#
# mdevd starts here and not under runsvdir: the mount scan below, flxdriver and
# every service need /dev populated, and a service would not be listening yet.
# There was also a var/service/mdevd, so two mdevd processes raced for the one
# uevent netlink socket.  One bound it, one failed, and runsvdir restarted the
# loser about once a second for the life of the system.
if [ -x /sbin/mdevd ]; then
    # -O 4: replay the uevents the kernel has already sent through a 4-group
    # readahead buffer instead of reading them one at a time.  On a machine
    # with a few hundred devices at boot that is the difference between the
    # coldplug finishing in a second and in ten.
    /sbin/mdevd -O 4 -f /etc/mdev.conf >>/var/log/mdevd.log 2>&1 &
    if [ -x /sbin/mdevd-coldplug ]; then
        /sbin/mdevd-coldplug >>/var/log/mdevd.log 2>&1 || :
    fi
fi
if [ -x /sbin/flxdriver ]; then
    /sbin/flxdriver probe >/dev/null 2>&1 || :
fi

# --- Persistent /home (disk=/home boot model) --------------------------------
# The ext4 partition labeled FLX_HOME carries the persistent /home.
# It is normally mounted by /sbin/flxautomount via mdevd hotplug; the scan
# below is a cold-boot fallback so /home is ready before services start.
# The bundled mount(1) needs an explicit -t (no auto-detect), so the
# partition type is resolved via blkid by label.
#
# The medium this system booted from is found the same way, by its volume id
# FREELINX_MEDIUM, and mounted read-only at /media/flx.  /usr/sbin/xsetup reads
# the installer from there, so without this the installer is on the disc and
# not reachable from the system booted off that disc.
#
# FREELINX_VAR is the third label, and it is what "data mode" is for.  That mode
# runs the system from RAM and keeps one filesystem on a disk for /var, so that
# state survives a reboot.  /var is where the things that must survive go:
# /var/lib/xpkg is the package database, /var/lib/lbu the local overlay,
# /var/log the logs, /var/cache the package cache.  In RAM-only mode all of that
# is thrown away on reboot, which is what makes a second disk worth creating.
#
# It is mounted before /home because a package database that is being read while
# the filesystem underneath it is still being written is not a thing to arrange
# on purpose.  noatime because the times of /var/lib are not interesting, and
# the writes they cost on every read are.
#
# Each scan waits for the device node.  /sys/class/block lists a partition
# before devtmpfs has made /dev/vdaN for it, and the bundled mount(8) says so
# plainly:
#
#   mount: /dev/vda3: No such file or directory
#
# which is indistinguishable from a partition that does not exist, so a scan
# that does not wait silently gives up on a disk that is perfectly fine.  The
# wait is on the node, not on the key being matched: a node that is present
# but carries the wrong UUID or label is a real answer and ends the loop at
# once.  One function serves both because they differ only in which blkid
# field is read, and a scan per field would be two copies of this loop.
flx_find() {
    _key=$1
    _want=$2
    _dev=
    _tries=0
    while [ "$_tries" -lt 50 ]; do
        for _pt in /sys/class/block/*; do
            [ -d "$_pt" ] || continue
            _name=$(basename "$_pt")
            _node="/dev/$_name"
            [ -b "$_node" ] || continue
            _out=$(blkid "$_node" 2>/dev/null || true)
            _got=$(echo "$_out" | grep -o "$_key=\"[^\"]*\"" | cut -d'"' -f2 || true)
            if [ "$_got" = "$_want" ]; then
                _dev=$_node
                break
            fi
        done
        [ -n "$_dev" ] && break
        _tries=$((_tries + 1))
        sleep 0.2
    done
    if [ -n "$_dev" ]; then
        _type=$(blkid "$_dev" 2>/dev/null | grep -o 'TYPE="[^"]*"' | cut -d'"' -f2 || true)
        printf '%s %s\n' "$_dev" "$_type"
    fi
}

# setup-disk records the UUIDs of the two ext4 partitions it made in
# /etc/flx-disk, and that file is the only thing that says which disk this
# system is.  A UUID, not a label: a second disk that happens to carry the
# label FLX_SYS or FLX_HOME -- a second install, a backup image, a stick
# someone formatted once -- must never be mounted into a running system.  A
# label is not unique, and the wrong filesystem mounted is worse than one
# missing, because nothing would report it.
flx_pin() {
    [ -r /etc/flx-disk ] || return 0
    sed -n "s/^$1=\([0-9A-Fa-f-]*\)\$/\1/p" /etc/flx-disk | head -1
}

if [ -x /bin/mount ] || [ -x /sbin/mount ]; then
    # The data filesystem: see the note above flx_find.
    #
    # Not fatal when it is absent.  A machine that was installed with sys or
    # none has no such partition, and that is the normal case, not a failure.
    # Failing to boot because an optional filesystem was not plugged in is worse
    # than the filesystem being missing.
    if ! grep -qs ' /var ' /proc/mounts; then
        set -- $(flx_find LABEL FREELINUX_VAR)
        if [ -n "${1:-}" ] && [ -n "${2:-}" ]; then
            mkdir -p /var
            grep -qs ' /var ' /proc/mounts \
                || mount -t "$2" -o noatime "$1" /var 2>/dev/null \
                || echo "FreeLinX: the data filesystem $1 is labelled FREELINUX_VAR but did not mount at /var; /var is in RAM and nothing will survive a reboot" >&2
        fi
    fi

    if ! grep -qs ' /home ' /proc/mounts; then
        _home_uuid=$(flx_pin FLX_HOME_UUID)
        if [ -n "$_home_uuid" ]; then
            set -- $(flx_find UUID "$_home_uuid")
        else
            set -- $(flx_find LABEL FLX_HOME)
        fi
        if [ -n "${1:-}" ] && [ -n "${2:-}" ]; then
            mkdir -p /home
            grep -qs " /home " /proc/mounts \
                || mount -t "$2" -o noatime "$1" /home 2>/dev/null \
                || echo "FreeLinX: the home filesystem $1 is pinned as FLX_HOME but did not mount at /home" >&2
        fi
    fi

    # The medium, read-only: this filesystem is the boot chain, and nothing on
    # a running system has a reason to write to it.
    if ! grep -qs ' /media/flx ' /proc/mounts; then
        set -- $(flx_find LABEL FREELINX_LIVE)
        if [ -n "${1:-}" ] && [ -n "${2:-}" ]; then
            mkdir -p /media/flx
            mount -t "$2" -o "ro,noatime,nodev,nosuid" "$1" /media/flx 2>/dev/null ||
                echo "FreeLinX: could not mount the medium $1 at /media/flx" >&2
        fi
    fi
fi

# --- Networking -------------------------------------------------------------
/sbin/ifconfig lo 127.0.0.1 up 2>/dev/null || /sbin/flxifconfig lo up 2>/dev/null || :
#
# The static 10.0.2.x layout below is the QEMU user-net topology (guest
# 10.0.2.15/24, gateway 10.0.2.2, DNS 10.0.2.3). It is only applied under
# QEMU (SMBIOS sys_vendor == QEMU); on real hardware the interface is left
# to dhcpcd, since hard-coding the QEMU addresses on a physical NIC would
# misconfigure the network.
if [ -r /sys/class/dmi/id/sys_vendor ] && grep -qi qemu /sys/class/dmi/id/sys_vendor; then
    /sbin/flxifconfig eth0 inet 10.0.2.15/24 2>/dev/null || /sbin/ifconfig eth0 10.0.2.15 netmask 255.255.255.0 up 2>/dev/null || :
    /sbin/flxifconfig eth0 up 2>/dev/null || :
    /sbin/flxroute add default 10.0.2.2 2>/dev/null || /sbin/route add default gw 10.0.2.2 2>/dev/null || :
    printf "nameserver 10.0.2.3\n" > /etc/resolv.conf
fi
/sbin/dhcpcd -q -b eth0 2>/dev/null || :

# --- hostname ---------------------------------------------------------------
_hostname=""
if [ -r /etc/hostname ]; then
    _hostname=$(cat /etc/hostname 2>/dev/null | tr -d '[:space:]')
fi
[ -n "$_hostname" ] && hostname "$_hostname"

# --- rescue -------------------------------------------------------------------
# "Rescue shell" in the boot menu passes flx.rescue=1: everything above is up
# (filesystems, devices), no service is started, and the console is a root shell.
case " $(cat /proc/cmdline 2>/dev/null) " in
*" flx.rescue=1 "*)
    echo "FreeLinX: rescue shell (no services started).  exit or reboot when done." >&2
    exec /bin/sh -l </dev/console >/dev/console 2>&1
    ;;
esac

# --- runit service supervision -----------------------------------------------
if [ -x /sbin/runsvdir ]; then
    mkdir -p /var/service
    exec /sbin/runsvdir -P /var/service
fi

# --- rescue fallback ----------------------------------------------------------
echo "FreeLinX: runsvdir not found - starting rescue shell." >&2
if [ -x /bin/sh ]; then
    exec /bin/sh
fi
echo "FreeLinX: no rescue shell available." >&2
while :; do sleep 1; done